# ============ مطلوب ============
# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# مفتاح مزوّد الذكاء الاصطناعي (مجاني). الافتراضي: Groq  -> https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# نماذج بالترتيب (لو الأول وصل للحد اليومي ينتقل للتالي). راجع أسماء النماذج الحالية في موقع المزوّد.
LLM_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# نموذج سريع وخفيف لفحص الأمان واستخراج كلمات البحث
LLM_GUARD_MODELS=llama-3.1-8b-instant

# ============ اختياري: مزوّد احتياطي مجاني ============
# مثال Google Gemini (مفتاح مجاني من aistudio.google.com):
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# FALLBACK_LLM_MODELS=gemini-2.0-flash
# مثال OpenRouter (نماذج :free):
# FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1

# ============ المعرفة ============
CHANNEL_USERNAME=muslim_appss
# المجموعات التي يتعلم منها البوت (يوزرنيمات بدون @، مفصولة بفاصلة)
LEARN_GROUPS=muslimappss
# admins = يتعلم فقط من ردود/رسائل المشرفين (الأكثر أمانًا) | all = يتعلم من الجميع
GROUP_LEARN_MODE=admins
# كل كم ساعة يحدّث البوت معلومات القناة
SYNC_HOURS=6

# ============ الحماية والحدود ============
USE_LLM_GUARD=true
DAILY_LIMIT_PER_USER=40
PER_MINUTE_LIMIT=8

# ============ عام ============
# آيديات المشرفين على البوت (أرقام تيليجرام) مفصولة بفاصلة — لأوامر /sync و /stats
ADMIN_IDS=
BOT_NAME=مساعد تطبيقات المسلم
PROJECT_URL=https://github.com/YOUR_USERNAME/muslim-apps-bot
DB_PATH=data/bot.db
