# The static web app does not read API keys from environment files.
# Enter provider credentials in the browser Settings page instead.
# Never define VITE_* API keys: they are exposed in the public build.

# Safe development/build defaults (currently edited in the Settings page):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
